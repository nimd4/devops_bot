#!/bin/bash
set -e

echo "Stopping PostgreSQL..."
systemctl stop postgresql || true

echo "Removing old data directory..."
rm -rf /var/lib/postgresql/17/main

echo "Creating data directory..."
mkdir -p /var/lib/postgresql/17/main
chown postgres:postgres /var/lib/postgresql/17/main
chmod 0700 /var/lib/postgresql/17/main

echo "Creating .pgpass file for authentication..."
cat > /tmp/.pgpass.tmp << EOF
192.168.1.15:5432:replication:replicator:replicator_pass
EOF
chmod 0600 /tmp/.pgpass.tmp
chown postgres:postgres /tmp/.pgpass.tmp
mv /tmp/.pgpass.tmp /tmp/.pgpass

echo "Running pg_basebackup from master..."
sudo -u postgres PGPASSFILE=/tmp/.pgpass pg_basebackup -h 192.168.1.15 -U replicator -D /var/lib/postgresql/17/main -Fp -Xs -P -R -v --no-password --wal-method=stream

echo "Creating standby.signal..."
sudo -u postgres touch /var/lib/postgresql/17/main/standby.signal

echo "Creating postgresql.conf..."
cat > /var/lib/postgresql/17/main/postgresql.conf << 'EOF'
listen_addresses = '*'
wal_level = replica
max_wal_senders = 10
max_replication_slots = 10
hot_standby = on
wal_keep_size = 128MB
primary_conninfo = 'host=192.168.1.15 port=5432 user=replicator password=replicator_pass'
EOF
chown postgres:postgres /var/lib/postgresql/17/main/postgresql.conf
chmod 0644 /var/lib/postgresql/17/main/postgresql.conf

echo "Creating pg_hba.conf..."
cat > /var/lib/postgresql/17/main/pg_hba.conf << 'EOF'
local   all             postgres                                peer
local   all             all                                     peer
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256
host    replication     replicator     192.168.1.16/32         md5
host    all             all             192.168.1.0/24          scram-sha-256
EOF
chown postgres:postgres /var/lib/postgresql/17/main/pg_hba.conf
chmod 0640 /var/lib/postgresql/17/main/pg_hba.conf

echo "Creating pg_ident.conf..."
touch /var/lib/postgresql/17/main/pg_ident.conf
chown postgres:postgres /var/lib/postgresql/17/main/pg_ident.conf
chmod 0640 /var/lib/postgresql/17/main/pg_ident.conf

echo "Setting permissions..."
chown -R postgres:postgres /var/lib/postgresql/17/main
chmod 0700 /var/lib/postgresql/17/main

echo "Creating cluster configuration..."
pg_createcluster 17 main -d /var/lib/postgresql/17/main || true

echo "Starting PostgreSQL..."
pg_ctlcluster 17 main start

echo "Waiting for PostgreSQL to start..."
sleep 10

echo "Checking replication status..."
sudo -u postgres psql -c "SELECT pg_is_in_recovery();" || true

echo "Cleaning up .pgpass..."
rm -f /tmp/.pgpass /tmp/.pgpass.tmp
